PORT=4000
# Generate a long random string for production, e.g. `openssl rand -hex 32`
# or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional — only needed for the AI features (natural-language task creation, activity
# summaries, tag/checklist suggestions, plain-English performance summaries, deadline warnings).
# Everything else in the app works fine without this. Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional — only needed for email-based "Forgot Password" (a 6-digit code sent by email).
# Without these, Forgot Password falls back to the existing "ask Admin, or run reset-password.js"
# message — nothing breaks if you leave this blank. Any standard SMTP account works (a Gmail
# account with an "app password" is a common free choice: https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional — only needed for real push notifications to devices (desktop or mobile, installed
# as a PWA). Generate these once with: node generate-vapid-keys.js
# Without these, the app works exactly the same, just without push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional — only needed for WhatsApp task notifications. Requires a WhatsApp Business Cloud
# API account set up on Meta's side (a genuine free tier exists — no paid third-party service
# required). See DEPLOY.md for the honest details, including WhatsApp's 24-hour template rule.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
