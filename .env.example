# MIHIR Task Manager — environment variables.
# Copy to .env for local development. In production set these in Render → Environment.
# NEVER commit real values. Every variable the code reads is listed here.

# ───────── REQUIRED ─────────
# PostgreSQL connection string (production: Supabase → Project Settings → Database → URI).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/postgres
# Long random secret used to sign logins. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
JWT_SECRET=replace-with-a-long-random-string

# ───────── RECOMMENDED IN PRODUCTION ─────────
NODE_ENV=production
# Public address of the site (used for push-notification sender identity and links).
APP_BASE_URL=https://mihir-task-manager.onrender.com
# Business timezone for every deadline/reminder/report calculation (default Asia/Kolkata).
APP_TIMEZONE=Asia/Kolkata
# Comma-separated list of sites allowed to call the API from a browser. Unset = any origin
# (safe-ish because logins use bearer tokens, not cookies — but set it in production).
ALLOWED_ORIGINS=https://mihir-task-manager.onrender.com

# ───────── OPTIONAL: push notifications (free) ─────────
# Generate once: npx web-push generate-vapid-keys   (changing them makes devices re-subscribe)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://mihir-task-manager.onrender.com

# ───────── OPTIONAL: reminders (Phase 2) ─────────
# Daily reminder windows (IST) for T-3 / T-2 / T-1 days; "none" switches the window rules off.
REMINDER_WINDOWS=10:00,14:00,18:00
# A window missed while the server was asleep is still sent if it is at most this many hours old.
REMINDER_CATCHUP_HOURS=2
# Routine nudges are skipped if the person got a reminder about the same task within this many hours.
# Milestones (due today, 6 h / 2 h left, overdue, flags) are never held back. 5 = fewer messages,
# but then the 10:00 / 14:00 / 18:00 windows effectively become two a day.
AUTO_REMINDER_MIN_GAP_HOURS=3
# Minimum gap between two "Follow up" button presses reaching the same person about the same task.
FOLLOW_UP_COOLDOWN_HOURS=5
# Notification types also sent on WhatsApp (each message costs money). Default = important ones only.
WHATSAPP_NOTIFY_TYPES=task_assigned,deadline_due_today,deadline_passed,task_overdue_days,task_warning_urgent,task_flagged,admin_late_flag,follow_up

# ───────── OPTIONAL: email (password-reset codes) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ───────── OPTIONAL: WhatsApp reminders (Meta WhatsApp Cloud API) ─────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ───────── OPTIONAL: AI wording for deadline-risk warnings ─────────
ANTHROPIC_API_KEY=

# ───────── FEATURE FLAGS (all OFF until tested — see docs/AI.md) ─────────
ENABLE_AI_TASK_EXTRACTION=false
ENABLE_VOICE_TASKS=false
ENABLE_WHATSAPP_INTEGRATION=false
ENABLE_EMAIL_INGESTION=false
ENABLE_MEETING_AI=false
ENABLE_AI_BUDGET_LIMIT=true

# ───────── AI (Phase 5) ─────────
# gemini (default when AI_API_KEY is set) | mock (rule-based, for tests/demos — no cost)
AI_PROVIDER=gemini
AI_API_KEY=
# The same key also switches on "✨ Fix" (spelling / grammar / punctuation) on every text box — about ₹0.01 per fix.
AI_MODEL=gemini-2.5-flash-lite
MONTHLY_AI_BUDGET_INR=1000
# Alert Admin at this share of the budget (0.8 = 80 %); AI stops at 100 %.
AI_COST_ALERT_THRESHOLD=0.8
USD_INR=88
# Below this confidence a suggestion is never confirmable from WhatsApp (must be checked in the app).
AI_MIN_CONFIDENCE=0.6
AI_MAX_SUGGESTIONS=20
AI_MAX_SUGGESTIONS_MEETING=50

# ───────── FILE STORAGE (Supabase Storage, private bucket) ─────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=mihir-private
MEETING_RECORDING_RETENTION_DAYS=30
# Uploaded documents/photos/videos (app + WhatsApp) kept privately this many days (tasks keep the extracted text).
UPLOAD_RETENTION_DAYS=90
WHATSAPP_MEDIA_RETENTION_DAYS=30

# ───────── WHATSAPP INBOUND (Meta WhatsApp Cloud API webhook) ─────────
# Webhook URL: https://<site>/api/integrations/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ───────── EMAIL → TASK (tasks@mihirgroup.com) ─────────
# Shared secret the mail forwarder sends in the X-Inbound-Secret header.
EMAIL_INBOUND_SECRET=

# ───────── JOBS ─────────
JOB_TICK_SECONDS=15
DISABLE_JOB_WORKER=false

# ───────── OPTIONAL: tuning ─────────
PORT=4000
# ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO
# Database connections kept open (Supabase free: keep ≤ 10).
DB_POOL_MAX=10
# Any single query is cancelled after this many milliseconds.
DB_STATEMENT_TIMEOUT_MS=25000
# Set to "disable" only for a local database without SSL.
PGSSLMODE=
# Client IP detection behind Render/Cloudflare; set "false" only if NOT behind a proxy.
TRUST_FORWARDED_FOR=
# Where scripts/backup-database.js writes backups (default ./backups).
BACKUP_DIR=

# ───────── DEVELOPMENT / TESTS ONLY — never set in production ─────────
# DB_SIMULATED_LATENCY_MS=120   adds delay to every query (benchmarks)
# EXPOSE_QUERY_COUNT=1          adds an X-Queries response header (benchmarks)
# E2E_BASE_URL=http://localhost:4000   Playwright end-to-end tests
